# Example secrets configuration
# Copy to .dev.vars and fill in actual values for local development
# NEVER commit .dev.vars to git

# Required for first-run claim (random token, ≥32 chars)
SETUP_TOKEN=changeme-generate-random-token

# Session encryption (random, ≥32 chars; auto-generated by setup script)
SESSION_SECRET=changeme-generate-random-secret

# Visit token encryption key for v1.2 (random, ≥32 chars)
TOKEN_KEY=changeme-generate-random-key

# Firebase Auth (only if AUTH_PROVIDERS includes "firebase")
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# Optional: Slack webhook for weekly digest
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Cloudflare API for R2 backups
# CF_API_TOKEN=your-api-token
# CF_ACCOUNT_ID=your-account-id
